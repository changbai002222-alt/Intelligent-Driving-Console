# 车端「协同观察器」配置模板
#
# 用法：复制成 runtime/convoy-observer.env，填好下面三项。
#（convoy-observer.env 已被 .gitignore 忽略，不会进仓库；里面的 token 别外传。）
#
# 车名必须和管理平台上登记的车辆名【完全一致】，否则后端对不上人。

# 本机管理平台地址（你的 PC，跑 start.bat 那台）。
# 注意不要写 127.0.0.1 —— 那是车自己；要写 PC 在局域网里的 IP。
CONVOY_URL=http://192.168.31.74:8870

# 必须与【PC 上】runtime/convoy.json 里的 observer_token 一致。
# 生成方法：python -c "import secrets;print(secrets.token_hex(16))"
CONVOY_TOKEN=REPLACE_ME

# 这台车叫什么（例：实训车01 / 实训车03）
CONVOY_VEHICLE=实训车01
